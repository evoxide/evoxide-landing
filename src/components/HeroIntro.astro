<hero-intro class="group block" data-state="server">
  <p
    data-hero-item
    class="mb-4 inline-block translate-y-5 rounded-full border border-line bg-panel px-4 py-1.5 text-xs font-semibold text-accent opacity-0 transition-[opacity,transform] duration-700 ease-out sm:mb-6 sm:px-4 sm:py-2 sm:text-sm"
  >
    Инженерная команда
  </p>

  <h1
    data-hero-item
    class="hero-title mx-auto mb-5 flex min-h-[calc(3.4em+16px)] w-full max-w-[1180px] translate-y-5 flex-col items-center justify-center text-[clamp(1.5rem,7.8vw,2.35rem)] font-extrabold leading-[1.02] tracking-[-.055em] opacity-0 transition-[opacity,transform] duration-700 ease-out [text-wrap:balance] sm:mb-7 sm:min-h-[calc(3.6em+18px)] sm:text-[clamp(2.45rem,min(6.6vw,8.5vh),7.5rem)] sm:leading-[.98] sm:tracking-[-.065em]"
  >
    <span class="flex flex-col items-center [text-shadow:0_8px_42px_rgb(0_0_0_/_0.62)]">
      <span
        data-hero-text
        data-text="Автоматизация."
        class="block min-h-[.98em]"
      >Автоматизация.</span>
      <span data-hero-text data-text="Интеграция." class="block min-h-[.98em]">Интеграция.</span>
      <span data-hero-text data-text="Оптимизация." class="block min-h-[.98em] text-brand">Оптимизация.</span>
    </span>
    <span
      data-hero-text
      data-text="Там, где это сложно."
      class="mt-3 block min-h-[1.2em] text-[.48em] font-medium leading-[1.2] tracking-[-.035em] text-muted sm:mt-4"
    >Там, где это сложно.<span
        data-hero-cursor
        class="inline-block font-medium text-accent [text-shadow:0_0_18px_rgb(196_69_14_/_0.5)] motion-safe:animate-pulse"
        aria-hidden="true"
      >|</span></span>
  </h1>

  <p
    data-hero-item
    class="hero-supporting-copy mx-auto mb-5 max-w-[760px] translate-y-5 text-base leading-6 text-muted opacity-0 transition-[opacity,transform] duration-700 ease-out sm:mb-7 sm:text-xl sm:leading-8"
  >
    Парсинг, микросервисы, BI, алгоритмы для производства и DevOps под ключ.
  </p>

  <div data-hero-item class="hero-actions flex translate-y-5 flex-wrap justify-center gap-2 opacity-0 transition-[opacity,transform] duration-700 ease-out sm:gap-4">
    <a
      class="inline-flex items-center justify-center rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-copy shadow-[0_10px_40px_rgb(196_69_14_/_0.32)] transition hover:-translate-y-0.5 hover:bg-brand-hover sm:px-8 sm:py-3.5"
      href="#contacts"
    >Обсудить задачу</a>
    <a
      class="inline-flex items-center justify-center rounded-full border border-line bg-panel px-5 py-2.5 text-sm font-semibold text-copy transition hover:-translate-y-0.5 hover:border-line-strong sm:px-8 sm:py-3.5"
      href="#cases"
    >Смотреть кейсы</a>
  </div>
</hero-intro>

<script>
  type Cleanup = () => void;

  const hiddenClasses = ["opacity-0", "translate-y-5"];
  const visibleClasses = ["opacity-100", "translate-y-0"];

  const setItemVisibility = (element: HTMLElement, visible: boolean): void => {
    element.classList.remove(...(visible ? hiddenClasses : visibleClasses));
    element.classList.add(...(visible ? visibleClasses : hiddenClasses));
  };

  class HeroIntroElement extends HTMLElement {
    private cleanup: Cleanup | null = null;

    connectedCallback(): void {
      if (this.cleanup) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const heroTitle = this.querySelector<HTMLElement>("h1");
      const heroCursor = this.querySelector<HTMLElement>("[data-hero-cursor]");
      const typingParts = Array.from(this.querySelectorAll<HTMLElement>("[data-hero-text]"));
      const introItems = Array.from(this.querySelectorAll<HTMLElement>("[data-hero-item]"));

      if (!heroTitle || !heroCursor || typingParts.length === 0 || introItems.length === 0) return;

      if (reducedMotion) {
        introItems.forEach(item => setItemVisibility(item, true));
        this.dataset.state = "visible";
        this.cleanup = () => {};
        return;
      }

      const timers = new Set<number>();
      let disposed = false;

      const schedule = (callback: () => void, delay: number): void => {
        const timer = window.setTimeout(() => {
          timers.delete(timer);
          if (!disposed) callback();
        }, delay);
        timers.add(timer);
      };

      const showItem = (element: HTMLElement | undefined): void => {
        if (element) setItemVisibility(element, true);
      };

      const showAll = (): void => {
        typingParts.forEach(part => {
          part.textContent = part.dataset.text ?? "";
        });
        typingParts.at(-1)?.append(heroCursor);
        heroCursor.classList.add("animate-pulse");
        introItems.forEach(item => setItemVisibility(item, true));
        this.dataset.state = "visible";
      };

      this.dataset.state = "animating";
      introItems.forEach(item => setItemVisibility(item, false));

      const typePart = (partIndex = 0, charIndex = 0): void => {
        const part = typingParts[partIndex];

        if (!part) {
          heroCursor.classList.add("animate-pulse");
          schedule(() => showItem(introItems[2]), 360);
          schedule(() => showItem(introItems[3]), 820);
          schedule(() => {
            this.dataset.state = "visible";
          }, 820);
          return;
        }

        part.append(heroCursor);
        const text = part.dataset.text ?? "";

        if (charIndex < text.length) {
          part.insertBefore(document.createTextNode(text.charAt(charIndex)), heroCursor);
          schedule(() => typePart(partIndex, charIndex + 1), 52);
        } else {
          schedule(() => typePart(partIndex + 1), 220);
        }
      };

      typingParts.forEach(part => {
        part.textContent = "";
      });
      heroCursor.classList.remove("animate-pulse");

      schedule(() => showItem(introItems[0]), 850);
      schedule(() => {
        showItem(introItems[1]);
        typePart();
      }, 1500);

      this.cleanup = () => {
        disposed = true;
        timers.forEach(timer => window.clearTimeout(timer));
        timers.clear();
        showAll();
      };
    }

    disconnectedCallback(): void {
      this.cleanup?.();
      this.cleanup = null;
    }
  }

  if (!customElements.get("hero-intro")) {
    customElements.define("hero-intro", HeroIntroElement);
  }
</script>
